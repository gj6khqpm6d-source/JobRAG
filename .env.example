# Development fallback (works without Docker)
DATABASE_URL=sqlite:///./data/jobrag.db

# Final PostgreSQL + pgvector setup
# DATABASE_URL=postgresql+psycopg://jobrag:jobrag@127.0.0.1:5432/jobrag

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=refs/pr/130
EMBEDDING_DIMENSIONS=1024
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=2
MODEL_CACHE_DIR=./data/models

# Optional Cloudflare fallback: set EMBEDDING_PROVIDER=cloudflare and
# EMBEDDING_MODEL=@cf/baai/bge-m3 before filling these values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=1200
# Optional: set these to the current provider prices to enable cost estimates.
DEEPSEEK_INPUT_COST_PER_MILLION=0
DEEPSEEK_OUTPUT_COST_PER_MILLION=0
OPS_LOG_RETENTION_DAYS=30
